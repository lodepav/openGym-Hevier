<?xml version="1.0" encoding="utf-8" ?>
<!-- [hevier] The fork's manifest overlay (seam S7, hevier/DECISIONS.md D24): hevier.gradle makes it
     the debug and release source sets' manifest, and the manifest merger folds it into upstream's
     src/main one. It locks the app to portrait (D24) and declares the home-screen month widget,
     which needs no permission (D44). "Find gyms nearby" (D47) uses the location permissions
     upstream's manifest declares for its gym reminder, asked for on its first tap, app open.
     For a Bluetooth heart-rate strap (D79) it asks for Nearby devices, scanning declared not for
     location (Android 12 on; before, the scan needs the location already asked for), and declares
     the foreground service that records the strap while a workout runs.
     It removes upstream's camera permission, which only its barcode scan of a gym check-in uses,
     hidden in the fork (D12), whose scanner the fork leaves out (D50), and the background location
     and location foreground service upstream's gym reminder needs (1.4.3), hidden in the fork too
     (D16): "Find gyms nearby" asks for one position with the app open. Its exported boot receiver,
     which only registers that reminder's gyms again, is removed with them.
     It reads OpenBite's phase (D93): a permission OpenBite grants only to an app signed with its key,
     and the visibility Android 11 on needs to see its provider. The develop pair is for debug builds;
     HevierPhasePlugin never reads it in a release.
     It answers OpenBite with the strength signal (D95): a read-only provider, guarded by a permission
     only an app signed with this app's key can hold.
     Upstream 1.4.4 (D100): it removes the NFC permission and the sticker filter (the routine links
     stay, D37), the nine other launcher icons with Christmas and Halloween among them (one icon, D17;
     the picker is hidden), the long-press and Assistant shortcuts on the one left, and the Wear OS
     watch's exported listener service (no watch app in the fork; its library is still in the build,
     to be left out with the plugin on the release machine). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            tools:node="merge">
            <intent-filter tools:node="remove">
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="opengym.ch" android:pathPrefix="/nfc" />
            </intent-filter>
        </activity>
        <activity-alias android:name=".IconDefault" tools:node="merge">
            <meta-data android:name="android.app.shortcuts" tools:node="remove" />
        </activity-alias>
        <activity-alias android:name=".IconLight" tools:node="remove" />
        <activity-alias android:name=".IconMono" tools:node="remove" />
        <activity-alias android:name=".IconNeon" tools:node="remove" />
        <activity-alias android:name=".IconSky" tools:node="remove" />
        <activity-alias android:name=".IconOrange" tools:node="remove" />
        <activity-alias android:name=".IconPink" tools:node="remove" />
        <activity-alias android:name=".IconViolet" tools:node="remove" />
        <activity-alias android:name=".IconHalloween" tools:node="remove" />
        <activity-alias android:name=".IconChristmas" tools:node="remove" />
        <service android:name=".WatchListenerService" tools:node="remove" />
        <receiver
            android:name=".HevierMonthWidget"
            android:exported="false"
            android:label="@string/hevier_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hevier_widget_month_info" />
        </receiver>
        <service
            android:name=".HevierHrStrapService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <receiver android:name=".GymReminderBootReceiver" tools:node="remove" />
        <provider
            android:name=".HevierStrengthProvider"
            android:authorities="${applicationId}.strength"
            android:exported="true"
            android:permission="${applicationId}.permission.READ_STRENGTH" />
    </application>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <permission android:name="${applicationId}.permission.READ_STRENGTH" android:protectionLevel="signature" />
    <uses-permission android:name="io.github.lodepav.openbite.permission.READ_PHASE" />
    <uses-permission android:name="io.github.lodepav.openbite.develop.permission.READ_PHASE" />
    <queries>
        <provider android:authorities="io.github.lodepav.openbite.phase" />
        <provider android:authorities="io.github.lodepav.openbite.develop.phase" />
    </queries>
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
    <uses-permission android:name="android.permission.NFC" tools:node="remove" />
    <uses-feature android:name="android.hardware.nfc" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove" />
</manifest>
