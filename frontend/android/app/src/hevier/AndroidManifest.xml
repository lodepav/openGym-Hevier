<?xml version="1.0" encoding="utf-8" ?>
<!-- [hevier] The fork's manifest overlay (seam S7, hevier/DECISIONS.md D24): hevier.gradle makes it
     the debug and release source sets' manifest, and the manifest merger folds it into upstream's
     src/main one. It locks the app to portrait (D24), asks for the two Health Connect read
     permissions, each requested only when its switch is turned on (D27), declares the home-screen
     month widget, which needs no permission (D44), and asks for the location permissions "Find
     gyms nearby" requests on its first tap, while the app is open (D47). Upstream's v1.4.3
     declares the same Health Connect and location permissions; the merger keeps one of each. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            tools:node="merge" />
        <receiver
            android:name=".HevierMonthWidget"
            android:exported="false"
            android:label="@string/hevier_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hevier_widget_month_info" />
        </receiver>
    </application>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
