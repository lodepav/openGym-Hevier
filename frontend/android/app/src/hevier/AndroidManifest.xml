<?xml version="1.0" encoding="utf-8" ?>
<!-- [hevier] The fork's manifest overlay (seam S7, hevier/DECISIONS.md D24): hevier.gradle makes it
     the debug and release source sets' manifest, and the manifest merger folds it into upstream's
     src/main one. It locks the app to portrait, as the PWA manifest already is, and (D27) asks for
     the two Health Connect read permissions, each requested only when its switch is turned on.
     Upstream's v1.4.3 declares the same two; the merger keeps one of each. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            tools:node="merge" />
    </application>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
</manifest>
