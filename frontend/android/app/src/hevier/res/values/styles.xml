<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- [hevier] The fork is dark only (hevier/DECISIONS.md D17), so the system splash is too,
         instead of following the device's light mode. Build-type resources replace main's style of
         the same name, so this copies upstream's one item (src/main/res/values/styles.xml): if
         upstream changes AppTheme.NoActionBarLaunch, change it here the same way. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">#000000</item>
    </style>
</resources>
