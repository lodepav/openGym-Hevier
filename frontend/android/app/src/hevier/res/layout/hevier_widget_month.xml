<?xml version="1.0" encoding="utf-8"?>
<!-- [hevier] The home-screen month widget (D44, HevierMonthWidget.java): the month and its totals
     on top, the grid drawn into the image below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hv_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hevier_widget_bg"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hv_widget_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hv_widget_sum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:textColor="#FF9A9EA7"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/hv_widget_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/hevier_widget_name"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/hv_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/hevier_widget_empty"
        android:textColor="#FF9A9EA7"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
